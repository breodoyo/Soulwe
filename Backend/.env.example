# Server configuration
PORT=8080
ENV=development
GIN_MODE=debug
FRONTEND_URL=http://localhost:5173

# Database configuration (PostgreSQL - Phase 2)
DATABASE_URL=postgres://soulwe:devpassword@localhost:5432/soulwe_dev?sslmode=disable

# Authentication (JWT access token - Phase 3.2). JWT_SECRET is required:
# the server refuses to start without it. Use a long random value.
JWT_SECRET=replace-with-a-random-64-character-secret-key-for-soulwe
# JWT_REFRESH_SECRET is reserved for the refresh-token phase and NOT used yet.
JWT_REFRESH_SECRET=replace-with-a-different-random-64-character-refresh-secret

# Journal Encryption at Rest (AES-256-GCM - Phase 5)
JOURNAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI reflection provider (Phase 5). LLM_PROVIDER selects "claude" (default) or
# "gemini". Only the selected provider's key is required; when it is empty the
# journal still works and reflections are simply disabled. Journal content is
# never logged. LLM_MODEL optionally overrides the provider's default model.
LLM_PROVIDER=claude
LLM_MODEL=

# Anthropic Claude API. Used when LLM_PROVIDER=claude (the default).
ANTHROPIC_API_KEY=sk-ant-api03-placeholder-key

# Google Gemini API. Used when LLM_PROVIDER=gemini. Gemini's free tier may train
# on submitted content, so a production deployment (APP_ENV/ENV=production) also
# requires GEMINI_PAID=true to confirm a paid account; otherwise the server
# refuses to start.
GEMINI_API_KEY=
GEMINI_PAID=false

# Environment name also read by the AI provider guard. ENV above is the primary
# switch; APP_ENV is honoured as a fallback when ENV is unset.
APP_ENV=development
